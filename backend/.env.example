# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/steptrack
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password_here

# JWT Configuration
# Must be at least 32 characters (256 bits) - the app refuses to start otherwise.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRATION=86400000

# Google Sign-In
# Comma-separated OAuth client IDs accepted as the "aud" claim of Google ID tokens.
# A Flutter app needs one entry per platform it ships on. Leave blank to disable
# Google sign-in (POST /api/auth/google then returns 503).
GOOGLE_CLIENT_IDS=your-android-client-id.apps.googleusercontent.com,your-web-client-id.apps.googleusercontent.com

# Server Configuration
SERVER_PORT=8080

# CORS - only needed for Flutter Web; native builds do not send an Origin header.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
