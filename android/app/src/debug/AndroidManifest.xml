<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only: Android 9+ blocks plaintext HTTP by default, which
         would silently break every request to the local (http://) Spring Boot
         backend during development. Release builds do not get this override
         and must talk to an HTTPS backend. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
